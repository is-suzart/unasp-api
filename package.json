{
    "name": "unasp-api",
    "version": "0.0.1",
    "description": "UNASP API with Clean Architecture",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "bun dist/main.js",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "bun test",
        "test:watch": "bun test --watch",
        "test:cov": "bun test --coverage",
        "test:e2e": "bun test test/**/*.e2e-spec.ts",
        "seed:users": "bun run src/scripts/seed-users.ts",
        "seed:communities": "bun run src/scripts/seed-communities.ts",
        "seed:pages": "bun run src/scripts/seed-pages.ts",
        "db:setup": "bun run src/scripts/setup-db.ts"
    },
    "dependencies": {
        "@faker-js/faker": "^10.2.0",
        "@nestjs/common": "^10.0.0",
        "@nestjs/core": "^10.0.0",
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^10.0.0",
        "@nestjs/swagger": "^11.2.6",
        "@nestjs/typeorm": "^10.0.0",
        "@scalar/nestjs-api-reference": "^1.0.29",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.0",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "pg": "^8.11.0",
        "bcrypt": "^5.1.0",
        "reflect-metadata": "^0.1.13",
        "rxjs": "^7.8.1",
        "typeorm": "^0.3.17"
    },
    "devDependencies": {
        "@nestjs/cli": "^10.0.0",
        "@nestjs/schematics": "^10.0.0",
        "@nestjs/testing": "^10.0.0",
        "@types/bun": "latest",
        "@types/express": "^4.17.17",
        "@types/node": "^20.3.1",
        "@types/passport-jwt": "^4.0.1",
        "@types/supertest": "^2.0.12",
        "@typescript-eslint/eslint-plugin": "^6.0.0",
        "@typescript-eslint/parser": "^6.0.0",
        "eslint": "^8.42.0",
        "eslint-config-prettier": "^9.0.0",
        "eslint-plugin-prettier": "^5.0.0",
        "prettier": "^3.0.0",
        "supertest": "^6.3.3",
        "typescript": "^5.1.3"
    }
}
